<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Vitalis</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.omsilwal.NutriCorePrimal</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.omsilwal.NutriCorePrimal</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Vitalis uses the camera to scan barcodes and photograph meals so it can log their nutrition.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Vitalis reads activity (steps, active energy, time in daylight) to adjust your targets, and body and heart readings (weight, body fat, waist, blood pressure, resting heart rate, heart rate variability, blood glucose) to show them next to your diet. Health data stays on your iPhone.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Vitalis saves the calories, protein and water you log to Apple Health.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Vitalis uses your location to find butchers and farms near you, show local weather and work out today's sunlight.</string>
	<key>UIAppFonts</key>
	<array>
		<string>ArchivoBlack-Regular.ttf</string>
		<string>IBMPlexMono-Regular.ttf</string>
		<string>IBMPlexMono-Medium.ttf</string>
		<string>IBMPlexMono-SemiBold.ttf</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
